# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL runtime connection variables (auto-injected in production)
SQL_HOST="/cloudsql/YOUR_PROJECT:REGION:INSTANCE"
SQL_DB_NAME="ai_studio_db"
SQL_USER="ai_studio_user"
SQL_PASSWORD="YOUR_USER_PASSWORD"

# Cloud SQL PostgreSQL schema migration variables
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD"

# JWT Secret for secure session tokens
JWT_SECRET="YOUR_JWT_SECRET_STRING_AT_LEAST_32_CHARS"

# Administrative User initial configuration (optional override)
ADMIN_EMAIL="admin@crisbeauty.com.br"
ADMIN_INITIAL_PASSWORD="CrisBeauty2026!Admin"

# Optional: Email Service credentials (SMTP) for sending password reset emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="YOUR_SMTP_SECRET_KEY"
SMTP_FROM="Cris_Beauty <nao-responda@crisbeauty.com.br>"
